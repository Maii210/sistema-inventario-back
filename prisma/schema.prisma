generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String     @id @default(uuid())
  name          String
  brand         String?
  minStock      Int        @default(0)
  category      Category   @default(OTRO)
  price         Float
  purchasePrice Float?
  stock         Int        @default(0)
  image         String?
  description   String?
  barcode       String?    @unique
  supplierId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  supplier      Supplier?  @relation(fields: [supplierId], references: [id])
  saleItems     SaleItem[]

  @@map("products")
}

model Supplier {
  id          String    @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("suppliers")
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  documentId String?  @unique
  lastName   String?
  createdAt  DateTime @default(now())
  sales      Sale[]

  @@map("customers")
}

model StaffUser {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(vendedora)
  active    Boolean  @default(true)
  phone     String?
  lastName  String?
  createdAt DateTime @default(now())
  sales     Sale[]

  @@map("staff_users")
}

model Sale {
  id               String        @id @default(uuid())
  date             DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customerName     String        @default("Consumidor final")
  customerEmail    String?
  customerPhone    String?
  customerId       String?
  userId           String?
  discount         Float         @default(0)
  paymentReference String?
  subtotal         Float
  total            Float
  paymentMethod    PaymentMethod @default(efectivo)
  items            SaleItem[]
  customer         Customer?     @relation(fields: [customerId], references: [id])
  user             StaffUser?    @relation(fields: [userId], references: [id])

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String?
  name      String
  price     Float
  quantity  Int
  discount  Float    @default(0)
  product   Product? @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

enum Role {
  admin
  vendedora
  inventarista
}

enum PaymentMethod {
  efectivo
  qr
  transfer
  card
}

enum Category {
  PERFUMERIA
  CUIDADO_PERSONAL
  COSMETICOS
  OTRO
}
